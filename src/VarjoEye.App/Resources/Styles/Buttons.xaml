<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
    <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Height" Value="48" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12,8" />
  </Style>
  <Style x:Key="RecalibrateButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryActionButtonStyle}">
    <Setter Property="Background" Value="{ThemeResource VarjoBrush}" />
  </Style>
  <Style x:Key="TrainModelButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryActionButtonStyle}">
    <Setter Property="Background" Value="{ThemeResource BaballoniaBrush}" />
  </Style>
</ResourceDictionary>
