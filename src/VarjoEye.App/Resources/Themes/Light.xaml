<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="AppCardColor">#D9FFFFFF</Color>
  <Color x:Key="AppNestedSurfaceColor">#F2F4F7FC</Color>
  <Color x:Key="AppStrokeColor">#D0D9E6</Color>
  <Color x:Key="AppPrimaryTextColor">#1B2430</Color>
  <Color x:Key="AppSecondaryTextColor">#5B6B80</Color>
  <Color x:Key="AppVarjoColor">#2F6FE6</Color>
  <Color x:Key="AppBaballoniaColor">#8B32E0</Color>
  <Color x:Key="AppCombinedColor">#0F9F5C</Color>
  <Color x:Key="AppWarningColor">#C4841A</Color>
  <Color x:Key="AppErrorColor">#C42B1C</Color>
  <Color x:Key="AppSuccessColor">#0F9F5C</Color>

  <SolidColorBrush x:Key="AppCardBrush" Color="{StaticResource AppCardColor}" />
  <SolidColorBrush x:Key="AppNestedSurfaceBrush" Color="{StaticResource AppNestedSurfaceColor}" />
  <SolidColorBrush x:Key="AppStrokeBrush" Color="{StaticResource AppStrokeColor}" />
  <SolidColorBrush x:Key="AppPrimaryTextBrush" Color="{StaticResource AppPrimaryTextColor}" />
  <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="{StaticResource AppSecondaryTextColor}" />
  <SolidColorBrush x:Key="VarjoBrush" Color="{StaticResource AppVarjoColor}" />
  <SolidColorBrush x:Key="BaballoniaBrush" Color="{StaticResource AppBaballoniaColor}" />
  <SolidColorBrush x:Key="CombinedBrush" Color="{StaticResource AppCombinedColor}" />
  <SolidColorBrush x:Key="AppWarningBrush" Color="{StaticResource AppWarningColor}" />
  <SolidColorBrush x:Key="AppErrorBrush" Color="{StaticResource AppErrorColor}" />
  <SolidColorBrush x:Key="AppSuccessBrush" Color="{StaticResource AppSuccessColor}" />
  <SolidColorBrush x:Key="AppOverlayBrush" Color="#CCF3F6FB" />
</ResourceDictionary>
