<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="AppCardBrush" Color="{ThemeResource SystemColorWindowColor}" />
  <SolidColorBrush x:Key="AppNestedSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
  <SolidColorBrush x:Key="AppStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
  <SolidColorBrush x:Key="AppPrimaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
  <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
  <SolidColorBrush x:Key="VarjoBrush" Color="{ThemeResource SystemColorHotlightColor}" />
  <SolidColorBrush x:Key="BaballoniaBrush" Color="{ThemeResource SystemColorHotlightColor}" />
  <SolidColorBrush x:Key="CombinedBrush" Color="{ThemeResource SystemColorHotlightColor}" />
  <SolidColorBrush x:Key="AppWarningBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
  <SolidColorBrush x:Key="AppErrorBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
  <SolidColorBrush x:Key="AppSuccessBrush" Color="{ThemeResource SystemColorHotlightColor}" />
  <SolidColorBrush x:Key="AppOverlayBrush" Color="{ThemeResource SystemColorWindowColor}" />
</ResourceDictionary>
