<Window
    x:Class="VarjoEye.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="VarjoEye">
  <Grid x:Name="RootGrid" Background="Transparent">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <TitleBar x:Name="AppTitleBar" Title="VarjoEye">
      <TitleBar.IconSource>
        <ImageIconSource ImageSource="ms-appx:///Assets/Icons/app-icon.png" />
      </TitleBar.IconSource>
    </TitleBar>

    <Frame x:Name="RootFrame" Grid.Row="1" />
  </Grid>
</Window>
