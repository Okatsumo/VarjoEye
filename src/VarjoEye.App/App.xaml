<Application
    x:Class="VarjoEye.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
        <ResourceDictionary Source="ms-appx:///Resources/Styles/Typography.xaml" />
        <ResourceDictionary Source="ms-appx:///Resources/Styles/Cards.xaml" />
        <ResourceDictionary Source="ms-appx:///Resources/Styles/Buttons.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default" Source="ms-appx:///Resources/Themes/Dark.xaml" />
        <ResourceDictionary x:Key="Dark" Source="ms-appx:///Resources/Themes/Dark.xaml" />
        <ResourceDictionary x:Key="Light" Source="ms-appx:///Resources/Themes/Light.xaml" />
        <ResourceDictionary x:Key="HighContrast" Source="ms-appx:///Resources/Themes/HighContrast.xaml" />
      </ResourceDictionary.ThemeDictionaries>

      <x:Double x:Key="CardCornerRadius">14</x:Double>
      <x:Double x:Key="NestedCornerRadius">10</x:Double>
      <x:Double x:Key="PagePadding">18</x:Double>
      <x:Double x:Key="CardPadding">16</x:Double>
      <x:Double x:Key="CardGap">14</x:Double>
      <CornerRadius x:Key="CardRadius">14</CornerRadius>
      <CornerRadius x:Key="NestedRadius">10</CornerRadius>
      <Thickness x:Key="CardBorderThickness">1</Thickness>

      <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
      <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
      <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="Transparent" />
      <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
