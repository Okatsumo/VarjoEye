<Page
    x:Class="VarjoEye.App.Features.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="860" HorizontalAlignment="Left" Padding="18,8,18,24" Spacing="0">
      <TextBlock Text="Settings" Style="{StaticResource SectionTitleTextStyle}" FontSize="24" Margin="0,0,0,4" />
      <TextBlock Text="Tracking, Baballonia and OSC options" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,18" />

      <TextBlock Text="General" Style="{StaticResource SectionTitleTextStyle}" FontSize="16" Margin="0,0,0,8" />
      <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
        <StackPanel Spacing="16">
          <StackPanel Spacing="8">
            <StackPanel Spacing="4">
              <TextBlock Text="App theme" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" />
              <TextBlock Text="Dark, Light, or match Windows" Style="{StaticResource CaptionTextStyle}" />
            </StackPanel>
            <RadioButtons MaxColumns="3"
                          SelectedIndex="{x:Bind ViewModel.ThemeModeIndex, Mode=TwoWay}">
              <RadioButton Content="Dark" />
              <RadioButton Content="Light" />
              <RadioButton Content="Windows" />
            </RadioButtons>
          </StackPanel>
          <TextBlock Text="Values stay in memory until the app is closed."
                     Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <TextBlock Text="Eye Tracking" Style="{StaticResource SectionTitleTextStyle}" FontSize="16" Margin="0,0,0,8" />
      <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
        <StackPanel Spacing="16">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4" VerticalAlignment="Center">
              <TextBlock Text="Output Frequency" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" />
              <TextBlock Text="Varjo gaze sampling mode" Style="{StaticResource CaptionTextStyle}" />
            </StackPanel>
            <ComboBox Grid.Column="1" Width="200"
                      ItemsSource="{x:Bind ViewModel.OutputFrequencies}"
                      SelectedIndex="{x:Bind ViewModel.OutputFrequencyIndex, Mode=TwoWay}" />
          </Grid>
          <Border Style="{StaticResource HairlineStyle}" />
          <StackPanel Spacing="4">
            <Grid>
              <TextBlock Text="Blink Sensitivity" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" />
              <TextBlock Text="{x:Bind ViewModel.BlinkSensitivityLabel, Mode=OneWay}"
                         Foreground="{ThemeResource VarjoBrush}" HorizontalAlignment="Right" />
            </Grid>
            <Slider Minimum="0" Maximum="100" Value="{x:Bind ViewModel.BlinkSensitivity, Mode=TwoWay}" />
          </StackPanel>
          <Border Style="{StaticResource HairlineStyle}" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4" VerticalAlignment="Center">
              <TextBlock Text="Raw Tracking Mode" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" />
              <TextBlock Text="Use raw Varjo gaze instead of the standard Varjo filter" Style="{StaticResource CaptionTextStyle}" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.RawTrackingMode, Mode=TwoWay}" />
          </Grid>
        </StackPanel>
      </Border>

      <TextBlock Text="Baballonia" Style="{StaticResource SectionTitleTextStyle}" FontSize="16" Margin="0,0,0,8" />
      <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
        <StackPanel Spacing="8">
          <TextBlock Text="Inference Device" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" />
          <TextBlock Text="DirectML adapters from DXGI. GPU failure falls back to CPU and is logged." Style="{StaticResource CaptionTextStyle}" />
          <ComboBox ItemsSource="{x:Bind ViewModel.InferenceDevices}"
                    SelectedIndex="{x:Bind ViewModel.InferenceDeviceIndex, Mode=TwoWay}"
                    HorizontalAlignment="Stretch" />
          <Border Style="{StaticResource HairlineStyle}" Margin="0,8" />
          <ToggleSwitch Header="Smooth Baballonia tracking"
                        IsOn="{x:Bind ViewModel.BaballoniaSmoothingEnabled, Mode=TwoWay}" />
          <TextBlock Text="Smooths gaze and eyelid movement to reduce jitter. Turn off for the fastest response; tracking may look noisier. Changes apply immediately."
                     Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
          <StackPanel Spacing="4">
            <Grid>
              <TextBlock Text="Smoothing strength" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" />
              <TextBlock Text="{x:Bind ViewModel.GazeSmoothingLabel, Mode=OneWay}"
                         Foreground="{ThemeResource BaballoniaBrush}" HorizontalAlignment="Right" />
            </Grid>
            <Slider Minimum="0" Maximum="100" StepFrequency="1"
                    IsEnabled="{x:Bind ViewModel.BaballoniaSmoothingEnabled, Mode=OneWay}"
                    AutomationProperties.Name="Baballonia smoothing strength"
                    Value="{x:Bind ViewModel.GazeSmoothing, Mode=TwoWay}" />
            <TextBlock Text="Lower values respond faster. Higher values reduce jitter but add delay. 0% keeps light smoothing; use the switch above to disable it completely. 35% matches the previous filter."
                       Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
      </Border>

      <TextBlock Text="OSC" Style="{StaticResource SectionTitleTextStyle}" FontSize="16" Margin="0,0,0,8" />
      <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
        <StackPanel Spacing="16">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4" VerticalAlignment="Center">
              <TextBlock Text="Send Tracking to OSC" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.SendTrackingToOsc, Mode=TwoWay}" />
          </Grid>
          <TextBox Header="Host" Text="{x:Bind ViewModel.OscHost, Mode=TwoWay}" />
          <NumberBox Header="Port"
                     Minimum="1"
                     Maximum="65535"
                     SpinButtonPlacementMode="Inline"
                     Value="{x:Bind ViewModel.OscPortValue, Mode=TwoWay}" />
        </StackPanel>
      </Border>

      <TextBlock Text="Advanced" Style="{StaticResource SectionTitleTextStyle}" FontSize="16" Margin="0,0,0,8" />
      <Border Style="{StaticResource CardBorderStyle}">
        <StackPanel Spacing="8">
          <ToggleSwitch Header="Measure tracking latency and FPS"
                        IsOn="{x:Bind ViewModel.TrackingDiagnosticsEnabled, Mode=TwoWay}" />
          <TextBlock Text="Measure Varjo API, Baballonia and camera latency and FPS, and write averages to the log every 5 seconds. Changes apply immediately without restarting tracking."
                     Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Page>
