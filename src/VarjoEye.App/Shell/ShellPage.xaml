<Page
    x:Class="VarjoEye.App.Shell.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
  <Grid>
    <NavigationView
        x:Name="NavView"
        PaneDisplayMode="Top"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        AlwaysShowHeader="False"
        Background="Transparent"
        SelectionChanged="NavView_OnSelectionChanged">
      <NavigationView.MenuItems>
        <NavigationViewItem Content="Eye Tracking" Tag="tracking" IsSelected="True">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE7B3;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Settings" Tag="settings">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE713;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Logs" Tag="logs">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE8A5;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.MenuItems>
      <Frame x:Name="ShellFrame" />
    </NavigationView>
  </Grid>
</Page>
